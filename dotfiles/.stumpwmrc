;;;; StumpWM configuration for lispbsd (NetBSD, X11 on wsfb).
;;;; Mirrors the niri keybindings used on the Linux ThinkPad: Super is the
;;;; modifier, bindings live on the top map, six named workspaces (groups).

(in-package :stumpwm)

;;;; -- Appearance --

(setf *mouse-focus-policy* :sloppy)
(setf *window-border-style* :thin)
(set-focus-color "#ffffff")
(set-unfocus-color "#505050")
(set-float-focus-color "#ffffff")
(set-float-unfocus-color "#505050")
(set-fg-color "#c5c9c5")
(set-bg-color "#080606")
(set-border-color "#505050")
(set-msg-border-width 1)
(setf *message-window-gravity* :center)
(setf *input-window-gravity* :center)
(setf *normal-border-width* 1)
(setf *maxsize-border-width* 1)
(setf *transient-border-width* 1)
(setf *window-format* "%m%n%s%20t")

(handler-case
    (set-font "-windows-profontwindows-medium-r-normal--12-120-72-72-c-60-microsoft-cp1252")
  (error () nil))

;;;; -- Workspaces --

(defparameter *workspace-names* '("1" "2" "3" "4" "5" "6"))

(when (equal (group-name (current-group)) "Default")
  (setf (group-name (current-group)) (first *workspace-names*)))
(dolist (name (rest *workspace-names*))
  (unless (find-group (current-screen) name)
    (gnewbg name)))

;;;; -- Commands --

(defcommand terminal () ()
  "Open a terminal window, reusing the alacritty daemon when it runs."
  (run-shell-command
   "alacritty msg --socket /tmp/alacritty.sock create-window 2>/dev/null || alacritty"))

(defcommand launcher () ()
  "Run dmenu with the niri wmenu look."
  (run-shell-command
   "dmenu_run -fn 'ProFontExtended-9' -nb '#000000' -nf '#ffffff' -sb '#E46876' -sf '#000000'"))

(defcommand screenshot () ()
  "Save a screenshot into the home directory like niri does."
  (run-shell-command "scrot \"$HOME/screenshot-%Y-%m-%d_%H-%M-%S.png\""))

(defcommand volume-up () ()
  "Raise the master volume."
  (run-shell-command "mixerctl -w outputs.master=+16"))

(defcommand volume-down () ()
  "Lower the master volume."
  (run-shell-command "mixerctl -w outputs.master=-16"))

(defcommand volume-mute () ()
  "Toggle master mute."
  (run-shell-command "mixerctl -w outputs.master.mute=toggle"))

(defcommand microphone-mute () ()
  "Toggle microphone mute."
  (run-shell-command "mixerctl -w record.mic2.mute=toggle 2>/dev/null || mixerctl -w record.mic.mute=toggle"))

(defcommand brightness-up () ()
  "Raise the panel backlight."
  (run-shell-command "brightness +10"))

(defcommand brightness-down () ()
  "Lower the panel backlight."
  (run-shell-command "brightness -10"))

(defcommand monitors-off () ()
  "Blank the display, like niri's power-off-monitors."
  (run-shell-command "xset dpms force off"))

(defcommand monitors-on () ()
  "Wake the Nano panel."
  (run-shell-command "xset dpms force on"))

;;;; -- Key bindings (niri layout, Super instead of Mod) --

(defmacro bind-top (&rest pairs)
  "Bind each KEY to COMMAND on the top-level map."
  `(progn
     ,@(loop for (key command) on pairs by #'cddr
             collect `(define-key *top-map* (kbd ,key) ,command))))

(bind-top
 "s-q"              "delete"
 "s-Left"           "strip-focus left"
 "s-Right"          "strip-focus right"
 "s-Up"             "strip-focus up"
 "s-Down"           "strip-focus down"
 "s-C-Left"         "strip-move left"
 "s-C-Right"        "strip-move right"
 "s-C-Up"           "strip-move up"
 "s-C-Down"         "strip-move down"
 "s-Home"           "strip-focus first"
 "s-End"            "strip-focus last"
 "s-C-Home"         "strip-move first"
 "s-C-End"          "strip-move last"
 "s-c"              "gselect 1"
 "s-i"              "gselect 2"
 "s-e"              "gselect 3"
 "s-a"              "gselect 4"
 "s-h"              "gselect 5"
 "s-t"              "gselect 6"
 "s-C-c"            "strip-workspace 1"
 "s-C-i"            "strip-workspace 2"
 "s-C-e"            "strip-workspace 3"
 "s-C-a"            "strip-workspace 4"
 "s-C-h"            "strip-workspace 5"
 "s-C-t"            "strip-workspace 6"
 "s-comma"          "strip-consume"
 "s-period"         "strip-expel"
 "s-r"              "strip-width preset"
 "s-f"              "strip-width max"
 "s-S-f"            "strip-fullscreen"
 "s-S-c"            "strip-center"
 "s-d"              "strip-width -"
 "s-w"              "strip-width +"
 "s-S-d"            "strip-height -"
 "s-S-w"            "strip-height +"
 "s-Tab"            "next"
 "s-S-Tab"          "prev"
 "Print"            "screenshot"
 "s-S-e"            "quit"
 "s-S-p"            "monitors-off"
 "s-p"              "launcher"
 "s-Return"         "terminal"
 "s-S-Return"       "exec if command -v dfly >/dev/null 2>&1; then alacritty -e dfly; else alacritty; fi"
 "s-u"              "exec if command -v e >/dev/null 2>&1; then e; else emacsclient -c -a emacs; fi"
 "s-o"              "monitors-on"
 "s-S-o"            "monitors-off"
 "s-semicolon"      "colon"
 "s-x"              "eval"
 "XF86AudioRaiseVolume" "volume-up"
 "XF86AudioLowerVolume" "volume-down"
 "XF86AudioMute"        "volume-mute"
 "XF86AudioMicMute"     "microphone-mute"
 "XF86MonBrightnessUp"   "brightness-up"
 "XF86MonBrightnessDown" "brightness-down")

;; Remove the old frame-deletion binding when reloading a tiling configuration.
(undefine-key *top-map* (kbd "s-S-r"))

;;;; -- Mode line (waybar-style right side) --
;;; A background daemon (/usr/local/bin/statusbard, started from ~/.xinitrc)
;;; refreshes /tmp/.statusline; the mode-line only reads that file, so a redraw
;;; never forks a subprocess on the event thread.  Colours match ~/.config/waybar.

(defvar *sb-file* "/tmp/.statusline")

(defun sb-read ()
  "Return the cached status line, or \"\" if it isn't there yet."
  (handler-case
      (with-open-file (s *sb-file* :if-does-not-exist nil)
        (if s (or (read-line s nil nil) "") ""))
    (error () "")))

(defun sb-get (line key &optional (default "?"))
  "Value of KEY=... in the whitespace-separated status LINE."
  (let* ((needle (concatenate 'string key "="))
         (pos (search needle line)))
    (if pos
        (let* ((start (+ pos (length needle)))
               (end (or (position #\Space line :start start) (length line)))
               (v (subseq line start end)))
          (if (zerop (length v)) default v))
        default)))

(defun sb-block (bg fg text)
  "A waybar-like coloured block with a little horizontal padding."
  (format nil "^(:bg \"~a\")^(:fg \"~a\") ~a ^n" bg fg text))

(defun sb-battery-block (line)
  (let* ((p (sb-get line "bat")) (st (sb-get line "bats"))
         (pn (or (parse-integer p :junk-allowed t) 100))
         (prefix (cond ((string= st "chg") "[++]") ((string= st "plug") "[==]")
                       ((string= st "full") "[00]") (t "[--]")))
         (text (format nil "~a~a% BAT" prefix p)))
    (cond ((member st '("chg" "plug" "full") :test #'string=)
           (sb-block "#26A65B" "#ffffff" text))
          ((<= pn 15) (sb-block "#f53c3c" "#ffffff" text))
          (t (sb-block "#ffffff" "#000000" text)))))

(defun sb-audio-block (line)
  (let ((vol (if (string= (sb-get line "volm" "off") "on") "MUTED"
                 (format nil "~a% VOL" (sb-get line "vol"))))
        (mic (if (string= (sb-get line "micm" "off") "on") "MUTED"
                 (format nil "~a% MIC" (sb-get line "mic")))))
    (sb-block "#8ba4b0" "#000000" (format nil "~a ~a" vol mic))))

(defun sb-right ()
  "Right side, waybar order: RAM TEMP CPU AUDIO [WIFI] BAT CLOCK."
  (handler-case
      (let* ((line (sb-read))
             (ssid (sb-get line "ssid" "")))
        (format nil "~a ~a ~a ~a ~a~a ~a"
                (sb-block "#000000" "#ffffff" (format nil "~a% RAM" (sb-get line "ram")))
                (sb-block "#000000" "#ffffff" (format nil "~a~aC" (sb-get line "temp") (code-char 176)))
                (sb-block "#E6C384" "#000000" (format nil "~a% CPU" (sb-get line "cpu")))
                (sb-audio-block line)
                (if (plusp (length ssid))
                    (concatenate 'string (sb-block "#2980b9" "#ffffff" ssid) " ") "")
                (sb-battery-block line)
                (sb-block "#E46876" "#000000" (sb-get line "clk" "--:--"))))
    (error () "")))

(setf *mode-line-background-color* "#000000")
(setf *mode-line-foreground-color* "#ffffff")
(setf *mode-line-border-color* "#000000")
(setf *mode-line-border-width* 0)
(setf *mode-line-pad-x* 2)
(setf *mode-line-pad-y* 1)
(setf *mode-line-timeout* 60)
;; left side unchanged (groups + windows); ^> right-justifies the waybar blocks
(setf *screen-mode-line-format*
      (list "^B[%g]^b %W ^> " '(:eval (sb-right))))
(enable-mode-line (current-screen) (current-head) t)

;;;; -- Startup --

(run-shell-command "hsetroot -solid '#0A0A0A'")
(run-shell-command "pgrep -x alacritty >/dev/null || { rm -f /tmp/alacritty.sock; alacritty --daemon --socket /tmp/alacritty.sock; }")

;;;; ==== LISPBSD battery fix: mode-line refresh without the SBCL busy-poll (2026-09-17) ====
;;;; StumpWM's periodic *mode-line-timer* keeps the event loop in a finite-timeout
;;;; xlib:event-listen, which this SBCL/NetBSD build busy-polls (~871k syscalls/s, ~2.5 W).
;;;; Cancel that timer and refresh through a separate X connection once a minute.
;;;; Send an Expose event, without clearing the bar or interrupting the WM thread.
(defvar *lispbsd-ml-thread* nil)
(defun lispbsd-ml-window-id ()
  ;; Retire the old fixed-15s refresher cooperatively during the first live reload.
  (when (and (equal (sb-thread:thread-name sb-thread:*current-thread*) "lispbsd-ml-refresher")
             (not (eq sb-thread:*current-thread* *lispbsd-ml-thread*)))
    (sb-thread:return-from-thread nil))
  (ignore-errors
    (let* ((head (current-head))
           (ml (and head (head-mode-line head))))
      (when ml (xlib:window-id (mode-line-window ml))))))

(defun lispbsd-ml-right ()
  "Return the right-side status blocks without debug I/O."
  (sb-right))

(setf *screen-mode-line-format*
      (list "^B[%g]^b %W ^> " '(:eval (lispbsd-ml-right))))
(ignore-errors (update-all-mode-lines))

(ignore-errors
  (let ((sym (find-symbol "*MODE-LINE-TIMER*" :stumpwm)))
    (when (and sym (boundp sym) (symbol-value sym))
      (cancel-timer (symbol-value sym))
      (setf (symbol-value sym) nil))))

(unless (boundp '*lispbsd-ml-interval*)
  (setf *lispbsd-ml-thread* nil))
(defparameter *lispbsd-ml-interval* 60)
(defun lispbsd-start-ml-refresher (&optional (interval *lispbsd-ml-interval*))
  (setf *lispbsd-ml-interval* interval)
  (unless (and *lispbsd-ml-thread* (sb-thread:thread-alive-p *lispbsd-ml-thread*))
    (setf *lispbsd-ml-thread*
          (sb-thread:make-thread
           (lambda ()
             (let ((dpy nil))
               (unwind-protect
                    (loop
                      (sleep *lispbsd-ml-interval*)
                      (handler-case
                          (progn
                            (unless dpy (setf dpy (xlib:open-default-display)))
                            (let ((id (and dpy (lispbsd-ml-window-id))))
                              (when id
                                (let ((w (xlib::lookup-window dpy id)))
                                  (when w
                                    (xlib:send-event w :exposure (quote (:exposure)) :window w :x 0 :y 0 :width 8192 :height 100 :count 0)
                                    (xlib:display-force-output dpy))))))
                        (serious-condition ()
                          (ignore-errors (when dpy (xlib:close-display dpy)))
                          (setf dpy nil))))
                 (ignore-errors (when dpy (xlib:close-display dpy))))))
           :name "lispbsd-ml-refresher"))))
(lispbsd-start-ml-refresher 60)

;;;; -- Scrolling columns --
(load (merge-pathnames ".stumpwm.d/scrolling.lisp" (user-homedir-pathname)))
