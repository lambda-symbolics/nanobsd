#!/bin/sh
# powerd(8) AC adapter hook (LISPBSD).
#   pressed  = adapter plugged in  -> restore the AC brightness
#   released = running on battery  -> restore the battery brightness
# The two levels are remembered separately by brightness(1), so plugging in
# no longer discards the level chosen on battery, or the other way round.
# The supply is passed explicitly because envstat can still be reporting the
# previous state at the instant this hook runs.
# The HWP energy/perf bias is no longer set here: lpschedd(8) owns EPP and
# reads the AC state we record in /var/run/lpsched.ac.
PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/bin; export PATH
# gefs+ background commits: every 30 s on AC, 90 s on battery.  fsync and
# sync stay durable at once; only the periodic commit of ordinary buffered
# writes waits longer (fewer NVMe wakeups on battery).
case "$2" in
pressed)  sysctl -w vfs.gefs.interval=30 >/dev/null 2>&1 ;;
released) sysctl -w vfs.gefs.interval=90 >/dev/null 2>&1 ;;
esac
case "$2" in
pressed)
	echo 1 > /var/run/lpsched.ac
	logger -p info -t acadapter \
	    "AC connected: brightness $(brightness restore ac)"
	;;
released)
	echo 0 > /var/run/lpsched.ac
	logger -p info -t acadapter \
	    "AC disconnected: brightness $(brightness restore bat)"
	;;
esac
# Sample package C-states once things settle: does plugging or pulling the
# (USB-C) charger leave the package out of PC10?  See /var/log/pcstate.log.
case "$2" in
pressed)  /usr/local/sbin/pcsample -d 30 ac-on </dev/null >/dev/null 2>&1 & ;;
released) /usr/local/sbin/pcsample -d 30 ac-off </dev/null >/dev/null 2>&1 & ;;
esac
# The bar shows the charging state: have its sampler publish it now.
pkill -USR2 -f '^/bin/sh /usr/local/bin/statusbard$' 2>/dev/null
exit 0
