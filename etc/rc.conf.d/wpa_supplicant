# Sourced by /etc/rc.d/wpa_supplicant after it sets command, so these win.
# Base 2.11 rejects Braiins-Public with "RSNXE mismatch ... msg 3/4"; this
# is upstream 2.11 with that check disabled (/var/tmp/wpa211).  Remove this
# file to go back to /usr/sbin/wpa_supplicant.
command="/usr/local/sbin/wpa_supplicant-2.11"

# Stopping a supplicant leaves iwx0 down and 2.11 never raises it
# ("interface is not up, cannot scan"): bring it up before starting.
wpa_supplicant_precmd()
{
    if [ ! -d /var/run/wpa_supplicant ]; then
        mkdir -p -m 755 /var/run/wpa_supplicant
    fi
    /sbin/ifconfig iwx0 up
    rc_flags="-B -s $rc_flags"
}
