#	$NetBSD: rc.local,v 1.32 2008/06/11 17:14:52 perry Exp $
#	originally from: @(#)rc.local	8.3 (Berkeley) 4/28/94
#
# This file is (nearly) the last thing invoked by /etc/rc during a
# normal boot, via /etc/rc.d/local.
#
# It is intended to be edited locally to add site-specific boot-time
# actions, such as starting locally installed daemons.
#
# An alternative option is to create site-specific /etc/rc.d scripts.
#

echo -n 'Starting local daemons:'

# Add your local daemons here, eg:
#
#if [ -x /path/to/daemon ]; then
#	/path/to/daemon args
#fi

echo '.'

# ensure DRM primary node exists for screentemp/gamma
[ -c /dev/dri/card0 ] || ( cd /dev && sh MAKEDEV drm0 )
[ -c /dev/vcam ] || mknod /dev/vcam c 370 0	# vcam(4), the virtual camera (om1 feeds it)

# battery: WiFi power save (~1.5 W)
ifconfig iwx0 powersave

# camera off by default (privacy); use `webcam on` to enable
/usr/local/bin/webcam off >/dev/null 2>&1

# bluetooth stays attached: the PerL Pro headphones use bta2dpd(8) + pad(4),
# and a `bluetooth on` re-attach after the boot-time detach left the Intel
# chip unresponsive (stuck USB transfer, 2026-10-10).  `bluetooth off` by hand
# if the radio is unwanted for a long battery stretch.
#/usr/local/bin/bluetooth off >/dev/null 2>&1

# The supply in use, for brightness(1) and lpschedd(8); powerd's AC hook
# keeps it current from here on.
# The gefs+ commit interval follows it too (see the acadapter hook).
case "$(envstat -d acpiacad0 2>/dev/null | awk '/connected/ { print $2 }')" in
TRUE) echo 1 > /var/run/lpsched.ac; sysctl -w vfs.gefs.interval=30 >/dev/null 2>&1 ;;
*)    echo 0 > /var/run/lpsched.ac; sysctl -w vfs.gefs.interval=90 >/dev/null 2>&1 ;;
esac

# Power down the platform IPs nothing here drives (camera IPU, sensor hub,
# CSME, GNA).  Separate from the USB-C/Thunderbolt group, which `usb`
# controls, so turning USB-C on no longer wakes these.
sysctl -w hw.acpi.sleep.idle_d3=1 >/dev/null 2>&1

# Disable unused USB data controllers; run `usb on` when needed.
/usr/local/bin/usb off >/dev/null 2>&1
# Enable tickless idle; s0ix preserves this policy across suspend.
sysctl -w machdep.cidle.tickless=1 >/dev/null 2>&1

# Wait for lid/button wake; set a positive timeout for bounded suspend tests.
sysctl -w hw.acpi.sleep.freeze_timeout=0 >/dev/null 2>&1

# Headphone jack: re-associate pin 0x21 so hdafg enables headphone
# redirection (see the script for the full reasoning).
[ -x /usr/local/sbin/hdafg-hp-fix ] && /usr/local/sbin/hdafg-hp-fix

# Replay the saved mixer levels.  This must follow hdafg-hp-fix: that
# reattaches the codec, which resets the mixer to its defaults.  The X
# session restores them again from .xinitrc, which also covers the mixer
# being re-enumerated later; doing it here as well means the console and
# any non-X login get the right level too.
[ -x /usr/local/bin/volume ] && HOME=/home/mag /usr/local/bin/volume restore

# The same reattach also zeroes the capture path that rc.d/mixerctl set from
# /etc/mixerctl.conf (record level muted, mic gain 0): replay the saved mic
# state, which also sets the F4 mute LED.
[ -x /usr/local/bin/mic ] && HOME=/home/mag /usr/local/bin/mic restore

# XDG runtime directory for the Wayland session (startmh).
mkdir -p /var/run/user/1000 && chown mag:users /var/run/user/1000 && chmod 700 /var/run/user/1000

# The lid only reports changes, and the change at boot comes before powerd
# listens.  With lid suspend off, replay a close when booting with the lid
# shut, so the backlight goes off and the session starts with the panel off.
if [ -e /etc/lid-nosuspend ] &&
    [ "$(sysctl -n hw.acpi.lid_closed 2>/dev/null)" = 1 ]; then
	/etc/powerd/scripts/lid_switch acpilid0 pressed
fi
