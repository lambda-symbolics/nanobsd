# Sourced at the end of /etc/rc.shutdown, after every rc.d script stopped.
#
# Some reboots wedge in the kernel's final phase (screen off, a core
# spinning, fans on).  The kernel now watches that phase itself (kernel 192,
# kern.lispbsd_shutdown_timeout): every unmount, detach, PMF shutdown and
# shutdown hook is named on the console before it runs, and a step that
# makes no progress for that long gets named once more and the machine is
# reset.  The message buffer survives the warm reset: read the end of the
# previous boot in dmesg ("shutdown watchdog: ... stuck in: ...").  That
# also covers plain reboot(8), which skips this script.
#
# The software watchdog stays as a second net.  -e arms it and exits with
# nobody tickling it (the old -x left a tickler process running), and its
# exit status is recorded.  It cannot fire while a stuck driver holds the
# kernel lock (its callout is not MPSAFE), hence the kernel watch above.
# $1 is the action; /var/tmp/rc.shutdown.final.ran records the last run.
case "$1" in
*halt*) ;;
*)	/sbin/wdogctl -e -p 180 swwdog0 >/dev/null 2>&1
	rc=$?
	{ date; echo "action: $1"; echo "wdogctl -e rc=$rc";
	  echo "kern.lispbsd_shutdown_timeout=$(/sbin/sysctl -n kern.lispbsd_shutdown_timeout 2>/dev/null)";
	  /sbin/wdogctl; } > /var/tmp/rc.shutdown.final.ran 2>&1
	if [ $rc -eq 0 ]; then
		echo "rc.shutdown.final: swwdog armed (180 s, no tickler)"
	else
		echo "rc.shutdown.final: swwdog NOT armed (wdogctl rc=$rc)"
	fi ;;
esac
