+static void
+xhci_rt_dl_clear_locked(struct xhci_softc *sc, struct xhci_slot *xs)
+{
+	KASSERT(mutex_owned(&sc->sc_intr_lock));
+	if (!xs->xs_idle_armed && !xs->xs_retry_armed)
+		return;
+	xs->xs_idle_armed = xs->xs_retry_armed = false;
+	KASSERT(sc->sc_rt_ndeadlines > 0);
+	if (--sc->sc_rt_ndeadlines == 0 && sc->sc_rt_armed) {
+		/* The last deadline went away: nothing left to wake up for. */
+		callout_stop(&sc->sc_rt_callout);
+		sc->sc_rt_armed = false;
+	}
