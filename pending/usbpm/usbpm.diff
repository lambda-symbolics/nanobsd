+{
+	KASSERT(mutex_owned(&sc->sc_intr_lock));
+	if (!xs->xs_rt_init || xs->xs_dev == NULL)
+		return;
+	xhci_rt_dl_count_locked(sc, xs);
+	xs->xs_idle_armed = false;
+	xs->xs_retry_armed = true;
+	xs->xs_retry_want = want;
+	xs->xs_retry_due = getticks() + MAX(delay, 1);
+	xs->xs_dormant = false;
