+/*
+ * hw.usbpm.{autosuspend,hid,deferrable}: every write (even of the same
+ * value) reconciles all controllers; autosuspend 0 also wakes the devices
+ * that sleep for idleness.
+ */
+static int
+sysctl_hw_usbpm_knob(SYSCTLFN_ARGS)
+{
+	struct sysctlnode node = *rnode;
+	struct xhci_softc *sc;
+	int *knob = rnode->sysctl_data;
+	int val, error, flags;
+
+	val = *knob;
+	node.sysctl_data = &val;
+	error = sysctl_lookup(SYSCTLFN_CALL(&node));
+	if (error || newp == NULL)
+		return error;
+	if (val < 0)
+		return EINVAL;
+	if (knob == &xhci_autosuspend && val > XHCI_RT_AUTOSUSPEND_MAX)
+		return EINVAL;
+	if (knob != &xhci_autosuspend && val > 1)
+		return EINVAL;
+
+	RUN_ONCE(&xhci_rt_once, xhci_rt_list_init);
+	mutex_enter(&xhci_rt_list_lock);
+	*knob = val;
+	flags = XHCI_RT_RC_RESET;
+	if (knob == &xhci_autosuspend && val == 0)
+		flags |= XHCI_RT_RC_WAKE;
+	LIST_FOREACH(sc, &xhci_rt_list, sc_rt_link)
+		xhci_rt_reconcile(sc, flags);
+	mutex_exit(&xhci_rt_list_lock);
+	return 0;
+}
+
+/* hw.usbpm.inject_*: a count, 0..1000000 (a negative value is refused). */
+static int
+sysctl_hw_usbpm_inject(SYSCTLFN_ARGS)
+{
+	struct sysctlnode node = *rnode;
+	u_int *cnt = rnode->sysctl_data;
+	int val, error;
+
+	val = (int)MIN(*cnt, 1000000u);
+	node.sysctl_data = &val;
+	error = sysctl_lookup(SYSCTLFN_CALL(&node));
+	if (error || newp == NULL)
+		return error;
+	if (val < 0 || val > 1000000)
+		return EINVAL;
+	atomic_swap_uint(cnt, (u_int)val);
+	return 0;
+}
