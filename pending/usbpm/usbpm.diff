+static void
+xhci_rt_idle_arm_locked(struct xhci_softc *sc, struct xhci_slot *xs)
+{
+	KASSERT(mutex_owned(&sc->sc_intr_lock));
+	if (!xs->xs_rt_init || xs->xs_dev == NULL || xs->xs_ctlrport == 0 ||
+	    sc->sc_dying)
+		return;
+	xs->xs_dormant = false;
+	if (xs->xs_retry_armed || xs->xs_suspended || xs->xs_resuming)
+		return;
+	if (!xhci_rt_enabled()) {
+		xhci_rt_dl_clear_locked(sc, xs);
+		return;
+	}
+	xhci_rt_dl_count_locked(sc, xs);
+	xs->xs_idle_armed = true;
