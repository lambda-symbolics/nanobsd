+/*
+ * Schedule the controller callout for getticks() == at.  hard: not
+ * deferrable.  sc_intr_lock held (the callout lock nests inside it).
+ */
+static void
+xhci_rt_schedule_locked(struct xhci_softc *sc, int at, bool hard)
+{
+	int delta;
+
+	KASSERT(mutex_owned(&sc->sc_intr_lock));
+	if (!xhci_rt_deferrable)
+		hard = true;
+	/*
+	 * A pending callout stays on its CPU, whose tickless sleep was set
+	 * for the old (later or deferrable) time; re-timing it would neither
+	 * wake nor IPI that CPU.  Stopped, it migrates to this (awake) CPU.
+	 */
+	if (sc->sc_rt_armed &&
+	    (hard || xhci_rt_tdiff(at, sc->sc_rt_armed_at) < 0))
+		callout_stop(&sc->sc_rt_callout);
+	if (!sc->sc_rt_armed || hard != sc->sc_rt_armed_hard)
+		callout_setdeferrable(&sc->sc_rt_callout, !hard);
+	delta = MAX(xhci_rt_tdiff(at, getticks()), 1);
+	callout_schedule(&sc->sc_rt_callout, delta);
+	sc->sc_rt_armed = true;
+	sc->sc_rt_armed_hard = hard;
+	/* When it is due to run (an overdue deadline runs on the next tick). */
+	sc->sc_rt_armed_at = getticks() + delta;
