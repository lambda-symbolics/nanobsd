+static void
+xhci_rt_dormant_locked(struct xhci_softc *sc, struct xhci_slot *xs)
+{
+	KASSERT(mutex_owned(&sc->sc_intr_lock));
+	xhci_rt_dl_clear_locked(sc, xs);
+	xs->xs_dormant = true;
+}
