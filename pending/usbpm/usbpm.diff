+/*
+ * An eligibility event from outside the slot's transition (pipe open or
+ * close, bind, port change): bump the generation, so that a task deciding
+ * with older facts does not override it, and arm the idle deadline.  The
+ * owner's own pipe traffic (ubt reopening its event pipe while being
+ * unparked by the task) is not news to the owner.
+ */
+static void
+xhci_rt_event_locked(struct xhci_softc *sc, struct xhci_slot *xs)
+{
+	KASSERT(mutex_owned(&sc->sc_intr_lock));
+	if (xs->xs_rt_owner != curlwp)
+		xs->xs_rt_gen++;
