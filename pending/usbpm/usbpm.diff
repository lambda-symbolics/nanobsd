+static void
+xhci_rt_arm_locked(struct xhci_softc *sc, int due, bool hard)
+{
+	KASSERT(mutex_owned(&sc->sc_intr_lock));
+	if (sc->sc_dying || sc->sc_rt_paused)
+		return;		/* xhci_rt_reconcile re-arms after the pause */
+	if (!xhci_rt_deferrable)
+		hard = true;
+	if (sc->sc_rt_armed) {
+		hard = hard || sc->sc_rt_armed_hard;
+		if (xhci_rt_tdiff(sc->sc_rt_armed_at, due) <= 0) {
+			if (hard == sc->sc_rt_armed_hard)
+				return;	/* runs first and rescans */
+			due = sc->sc_rt_armed_at;
+		}
+	}
+	xhci_rt_schedule_locked(sc, due, hard);
