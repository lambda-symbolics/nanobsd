#!/bin/sh
# bluetooth on|off|status - enable/disable the internal BT radio (ubt0 on uhub3).
# NetBSD has no A2DP, so BT is HID/PAN only here. Non-root uses doas.
PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/pkg/sbin:/usr/pkg/bin; export PATH
HUB=uhub3
SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="doas"
present(){ drvctl -l "$HUB" 2>/dev/null | grep -q ubt0; }
case "${1:-status}" in
  off)    $SUDO drvctl -d ubt0 2>/dev/null
          present && echo "bluetooth: still on (detach failed)" || echo "bluetooth: OFF" ;;
  on)     $SUDO drvctl -r "$HUB" 2>/dev/null; sleep 1
          present && echo "bluetooth: ON" || echo "bluetooth: on (re-attach pending; retry or reboot)" ;;
  status) present && echo "bluetooth: ON" || echo "bluetooth: OFF" ;;
  *) echo "usage: bluetooth [on|off|status]" >&2; exit 1 ;;
esac
