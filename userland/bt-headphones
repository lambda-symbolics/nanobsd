#!/bin/sh
# bt-headphones on|off|status [bdaddr] - A2DP to Bluetooth headphones via
# bta2dpd(8) reading pad(4).  on: resumes the PCH USB controller only (the
# radio sits behind it; the USB-C block stays cold), brings ubt0 up (the Intel firmware loads on the first up),
# starts the SSP-capable bthcid from /usr/local/sbin and sdpd, connects the
# stream daemon with an authenticated and encrypted link, and makes the pad
# the default audio device so every player ends up in the headphones.
# First pairing: put the headphones into pairing mode before "on"; the link
# key then lives in /var/db/bthcid.keys and later connections need nothing.
PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/bin:/usr/local/sbin:/usr/pkg/bin; export PATH
ADDR=${2:-8c:a9:6f:1e:89:66}	# Denon PerL Pro
DEV=ubt0
SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="doas"
pad_index(){ audiocfg list 2>/dev/null | awk '/@ pad0/ { sub(":", "", $1); print $1; exit }'; }
builtin_index(){ audiocfg list 2>/dev/null | awk '/hdafg0/ { sub(":", "", $1); print $1; exit }'; }
case "${1:-status}" in
  on)
	$SUDO usb on pch >/dev/null 2>&1
	# "bluetooth off" detaches the radio; usb on alone does not bring it back.
	drvctl -l uhub3 2>/dev/null | grep -q $DEV || { $SUDO drvctl -r uhub3; sleep 1; }
	$SUDO btconfig $DEV up 2>&1 | grep -v "^$"
	btconfig $DEV | grep -q UP || { echo "bt-headphones: $DEV did not come up (firmware? dmesg)"; exit 1; }
	# pgrep -x matches argv0 with its path, so "-x bthcid" never matched and
	# every run started a second bthcid: it re-sent the SSP/SC setup to the
	# controller (refused while a link is up), unlinked the running one's
	# control socket and exited on the pid file.
	pgrep -f '^/usr/local/sbin/bthcid' >/dev/null || $SUDO /usr/local/sbin/bthcid -d $DEV
	pgrep -x sdpd >/dev/null || $SUDO sdpd
	i=0; while [ ! -S /var/run/sdp ] && [ $i -lt 20 ]; do sleep 0.25; i=$((i+1)); done
	# The first connects fail.  The logs point at the headphones paging
	# this host themselves when it comes up, querying its SDP records and
	# dropping the link a few seconds later, with our connect riding their
	# link and failing with it (each failure comes ~1 s after their SDP
	# query ends; to be confirmed with hcisniff).  The nanobsd bta2dpd retries for up to -w seconds and
	# with -D returns only once the stream runs, so its exit status is the
	# answer (the base one detaches at once and a 2 s pgrep said "ON" while
	# it was still failing, hence the three runs).
	if ! pgrep -f "bta2dpd.*$ADDR" >/dev/null; then
		echo "bt-headphones: connecting to $ADDR"
		$SUDO /usr/local/sbin/bta2dpd -D -n -w 60 -m encrypt -d $DEV -a "$ADDR" /dev/pad0 || exit 1
	fi
	pgrep -f "bta2dpd.*$ADDR" >/dev/null || { echo "bt-headphones: no stream to $ADDR (see /var/log/messages)"; exit 1; }
	P=$(pad_index)
	[ -n "$P" ] && $SUDO audiocfg default "$P" && echo "bt-headphones: ON, audio${P} (pad) is the default device"
	;;
  off)
	B=$(builtin_index); [ -n "$B" ] && $SUDO audiocfg default "$B"
	$SUDO pkill -f "bta2dpd.*$ADDR"
	# Release what nothing else uses: the radio goes down when no other
	# stream daemon runs, and the PCH controller is suspended again unless
	# the camera is attached (webcam on).
	sleep 1
	if ! pgrep -x bta2dpd >/dev/null; then
		$SUDO btconfig $DEV down 2>/dev/null
		if ! drvctl -l uhub3 2>/dev/null | grep -q uvideo; then
			$SUDO usb off pch >/dev/null 2>&1
		fi
	fi
	echo "bt-headphones: OFF, built-in audio is the default device"
	;;
  status)
	btconfig $DEV 2>/dev/null | head -1
	pgrep -f "bta2dpd.*$ADDR" >/dev/null && echo "stream: connected to $ADDR" || echo "stream: off"
	audiocfg default 2>/dev/null | head -1
	;;
  *) echo "usage: bt-headphones [on|off|status] [bdaddr]" >&2; exit 1 ;;
esac
