#!/bin/sh
# cheatsheet [pattern] - the LISPBSD commands we made for this laptop, by
# subject, one line each.  With a pattern, only the matching lines.
# Sources live in nanobsd/userland (scripts, C) and ~/common-lisp (Lisp).
color=0; [ -t 1 ] && [ -z "$NO_COLOR" ] && color=1
h() { [ $color = 1 ] && printf '\n\033[1;33m%s\033[0m\n' "$1" || printf '\n== %s ==\n' "$1"; }
c() { [ $color = 1 ] && printf '  \033[1;36m%-22s\033[0m %s\n' "$1" "$2" || printf '  %-22s %s\n' "$1" "$2"; }
{
h "Radios, USB, camera"
c "usb on|off|status"        "suspend/resume both xHCI controllers (rc.local turns them off at boot; run 'on' before plugging anything)"
c "bluetooth on|off|status"  "attach/detach the Intel AX201 (ubt0); 'on' resumes USB first"
c "bt-headphones on|off"     "A2DP to the Denon PerL Pro: firmware, bthcid, bta2dpd on pad0, pad as default audio"
c "hcisniff [ubt0]"          "every HCI command/event/ACL packet with direction and decoded headers (root)"
c "btconfig ubt0 up"         "base: brings the radio up (loads the Intel firmware on the first up)"
c "wifi"                     "Common Lisp Wi-Fi TUI: scan, join, forget (never scan on hotel Wi-Fi remotely)"
c "wifi-powersave on|off"    "iwx power save (~1.5 W); live only"
c "webcam on|off|status"     "attach/detach the internal camera (uvideo)"
h "Power"
c "battery"                  "charge, state, time left"
c "s0ix"                     "kernel-coordinated s2idle (freeze); lid close does it on its own"
c "brightness [N|+N|-N|...]" "panel backlight: levels, dim/undim, restore ac|bat"
c "pcsample [-d S] LABEL"    "package C-state residency sample for A/B runs"
c "apst-ab, lpsched-ab, rr30/*" "A/B harnesses: NVMe APST, lpsched mechanisms, 30 Hz panel modes"
h "Audio"
c "volume up|down|mute|get"  "every output path at once (hdafg levels mapped to the DAC steps)"
c "hdafg-hp-fix"             "make the headphone jack usable on the ALC287 (rc.local)"
c "bta2dpd -m encrypt ..."   "base A2DP source; -m encrypt is what makes modern headsets pair"
h "Session and screen"
c "switch-to mahogany|stumpwm" "pick the session the console starts; startmh / startx-safe underneath"
c "mahoganyctl FORM"         "evaluate Lisp in the running Mahogany (never after a defstruct change)"
c "screenshot"               "freeze, select a region, save timestamped"
c "screentemp [K] [-d]"      "colour temperature of the panel"
c "statusbar / statusbard"   "one-shot status snapshot / the daemon that publishes it to the bar"
c "waytemp"                  "Wayland temperature/thermal readout"
c "wmenu-run"                "launcher"
h "System"
c "lsblk [-p|-c] [disk]"     "disks, wedges, file systems (probed), mounts and usage in real units, NVMe health"
c "lfetch"                   "the fetch, Genera style"
c "tickrate"                 "measure the timer tick rate"
c "cheatsheet [pattern]"     "this list"
h "Daemons (started by rc.local or the scripts above)"
c "lpschedd"                 "power governor userland half (machdep.lpsched)"
c "brightnessd"              "lets the session user change the backlight"
c "bthcid (/usr/local/sbin)" "pairing daemon with Secure Simple Pairing (just works)"
c "ndevd"                    "device hotplug events for Mahogany"
} | { if [ -n "$1" ]; then grep -i -- "$1"; else cat; fi; }
