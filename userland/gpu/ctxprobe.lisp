;; In Mahogany's own GLES context: reset strategy/status, then clear a scratch
;; FBO to red and read it back.  Restores the previous EGL binding.
(in-package #:mahogany)
(defmacro %gl (name ret &rest args)
  `(cffi:foreign-funcall ,name ,@args ,ret))
(defun %ctx-probe ()
  (let* ((server (state-server *compositor-state*))
         (renderer (cffi:mem-ref server :pointer 32))
         (egl (%gl "wlr_gles2_renderer_get_egl" :pointer :pointer renderer))
         (dpy (%gl "wlr_egl_get_display" :pointer :pointer egl))
         (ctx (%gl "wlr_egl_get_context" :pointer :pointer egl))
         (prev-ctx (%gl "eglGetCurrentContext" :pointer))
         (prev-dpy (%gl "eglGetCurrentDisplay" :pointer))
         (prev-draw (%gl "eglGetCurrentSurface" :pointer :int #x3059))
         (prev-read (%gl "eglGetCurrentSurface" :pointer :int #x305A))
         (null (cffi:null-pointer)) result)
    (%gl "eglMakeCurrent" :uint :pointer dpy :pointer null :pointer null :pointer ctx)
    (cffi:with-foreign-objects ((iv :int 4) (px :uint8 4) (fb :uint 1) (rb :uint 1) (prevfb :int 1))
      (%gl "glGetIntegerv" :void :uint #x8256 :pointer iv)  ; RESET_NOTIFICATION_STRATEGY
      (let* ((strategy (cffi:mem-aref iv :int 0))
             (fn (%gl "eglGetProcAddress" :pointer :string "glGetGraphicsResetStatusKHR"))
             (status (if (cffi:null-pointer-p fn) -1 (cffi:foreign-funcall-pointer fn () :uint))))
        (%gl "glGetIntegerv" :void :uint #x8CA6 :pointer prevfb) ; FRAMEBUFFER_BINDING
        (%gl "glGenRenderbuffers" :void :int 1 :pointer rb)
        (%gl "glBindRenderbuffer" :void :uint #x8D41 :uint (cffi:mem-ref rb :uint))
        (%gl "glRenderbufferStorage" :void :uint #x8D41 :uint #x8058 :int 16 :int 16) ; RGBA8
        (%gl "glGenFramebuffers" :void :int 1 :pointer fb)
        (%gl "glBindFramebuffer" :void :uint #x8D40 :uint (cffi:mem-ref fb :uint))
        (%gl "glFramebufferRenderbuffer" :void :uint #x8D40 :uint #x8CE0 :uint #x8D41
             :uint (cffi:mem-ref rb :uint))
        (let ((complete (%gl "glCheckFramebufferStatus" :uint :uint #x8D40)))
          (%gl "glDisable" :void :uint #x0C11) ; SCISSOR_TEST
          (%gl "glViewport" :void :int 0 :int 0 :int 16 :int 16)
          (%gl "glClearColor" :void :float 1.0 :float 0.0 :float 0.0 :float 1.0)
          (%gl "glClear" :void :uint #x4000)
          (dotimes (i 4) (setf (cffi:mem-aref px :uint8 i) 7))
          (%gl "glReadPixels" :void :int 3 :int 3 :int 1 :int 1 :uint #x1908 :uint #x1401 :pointer px)
          (setf result (list :strategy (format nil "#x~x" strategy)
                             :reset-status (format nil "#x~x" status)
                             :fbo-status (format nil "#x~x" complete)
                             :pixel (loop for i below 4 collect (cffi:mem-aref px :uint8 i))
                             :glerror (format nil "#x~x" (%gl "glGetError" :uint)))))
        (%gl "glBindFramebuffer" :void :uint #x8D40 :uint (cffi:mem-ref prevfb :int))
        (%gl "glDeleteFramebuffers" :void :int 1 :pointer fb)
        (%gl "glDeleteRenderbuffers" :void :int 1 :pointer rb)))
    (if (cffi:null-pointer-p prev-ctx)
        (%gl "eglMakeCurrent" :uint :pointer dpy :pointer null :pointer null :pointer null)
        (%gl "eglMakeCurrent" :uint :pointer prev-dpy :pointer prev-draw :pointer prev-read :pointer prev-ctx))
    result))
