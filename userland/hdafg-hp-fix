#!/bin/sh
# hdafg-hp-fix - make the headphone jack usable on the X1 Nano's ALC287.
#
# The codec describes pin 0x21 (the 3.5mm jack) as its own association
# (As=2 Seq=0).  hdafg(4) then tries to give that association its own DAC,
# but the speaker association has already claimed both DACs the codec has,
# so the trace fails and the jack is dropped entirely:
#
#   hdafg0: depth 2 nid 02 busy by assoc 0
#   hdafg0:   trace failed as=1 seq=0 pin=21 hpredir=-1 minassoc=0
#
# hdafg already implements headphone redirection -- sharing the speakers'
# DAC and switching on jack sense -- but only for a headphone pin that sits
# INSIDE the speaker association at sequence 15:
#
#   /* Headphones with seq=15 may mean redirection */
#   if (type == COP_DEVICE_HP_OUT && seq == 15)
#
# So rewrite pin 0x21's configuration default to association 1 / sequence 15
# and hand it back through the pin-config property.  The codec forgets this
# over a power cycle, so it is reapplied at boot.
#
# The codec reverts to its factory configuration on every power-on, so this
# only ever has to ADD overrides -- it must never try to "restore" a value.
# An earlier version did, with a global substitution of the unconnected-pin
# value, which rewrote EVERY unused pin (0x13, 0x18, 0x1a, 0x1b, 0x1e) into a
# speaker and left the codec with no usable output association at all.
#
# IMT_DROP_SPK2=1 additionally retires the second speaker pin (0x17) to make
# the group plain 2ch stereo.  That was tried to cure thin-sounding
# headphones and made the SPEAKERS equally thin, so it is off by default:
# 0x14 alone is evidently the small driver and both pins are needed.

PATH=/sbin:/usr/sbin:/bin:/usr/bin; export PATH
DEV=${1:-/dev/hdaudio0}
CUR=/tmp/hdafg-cur.$$
NEW=/tmp/hdafg-new.$$

hdaudioctl -f "$DEV" get 0 0x01 > "$CUR" 2>/dev/null || exit 0

# 0x21: headphones -> association 1, sequence 15 (redirection)
sed -e 's|<integer>0x3211020</integer>|<integer>0x321101f</integer>|' "$CUR" > "$NEW"
if [ "${IMT_DROP_SPK2:-0}" = 1 ]; then
	# 0x90170111 is pin 0x17 alone; pin 0x14 is 0x90170110.
	sed -i -e 's|<integer>0x90170111</integer>|<integer>0x411111f0</integer>|' "$NEW"
fi

if cmp -s "$CUR" "$NEW"; then
	rm -f "$CUR" "$NEW"
	exit 0			# already in the wanted state
fi
hdaudioctl -f "$DEV" set 0 0x01 "$NEW" >/dev/null 2>&1
rm -f "$CUR" "$NEW"
