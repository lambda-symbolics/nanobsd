;;;; ~/.config/lfetch/init.lisp
;;;;
;;;; LOADed raw into the LFETCH package after the defaults, so anything
;;;; can change: facts, entries, their order, the palette, the logo, even the
;;;; functions that draw them.  An error here is reported and the rest of the
;;;; run goes on.  Try a change with: lfetch --init this-file.lisp

;;; A new fact and a line that shows it.
(define-fact :load
  (let ((l (sh "/sbin/sysctl" "-n" "vm.loadavg")))
    (and l (words (trim (first (lines l)))))))  ; "0.42 0.31 0.25"

(define-entry :load "load"
  (let ((l (fact :load))) (and l (list (v "~{~A~^ ~}" l)))))

;;; Where it goes, and what to leave out.
(setf *herald* (append (remove :audio *herald*) '(:load)))

