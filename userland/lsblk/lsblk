#!/bin/sh
# lsblk: list disks, their wedges or disklabel partitions, sizes, file
# system types and where they are mounted, roughly like Linux's lsblk.
#   lsblk [-b] [disk ...]     -b prints sizes in bytes
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
bytes=0
while getopts b opt; do
	case $opt in
	b) bytes=1 ;;
	*) echo "usage: lsblk [-b] [disk ...]" >&2; exit 2 ;;
	esac
done
shift $((OPTIND - 1))
[ $bytes = 1 ] && sw=13 || sw=8

all=$(sysctl -n hw.disknames)
if [ $# -gt 0 ]; then disks="$*"; else
	disks=$(for d in $all; do case $d in dk[0-9]*) ;; *) echo $d ;; esac; done)
fi

# "device mountpoint" pairs, swap included.
mounts=$( { mount | awk '$1 ~ "^/dev/" {sub("^/dev/", "", $1); print $1, $3}'
	    swapctl -l 2>/dev/null | awk 'NR > 1 {sub("^/dev/", "", $1); print $1, "[SWAP]"}'; } )

human() {
	if [ $bytes = 1 ]; then echo "$1"; return; fi
	echo "$1" | awk '{ n = $1; split("B K M G T P", u, " "); i = 1
		while (n >= 1024 && i < 6) { n /= 1024; i++ }
		if (i == 1) printf "%dB\n", n; else if (n >= 100) printf "%.0f%s\n", n, u[i]
		else printf "%.1f%s\n", n, u[i] }'
}

# disk-info of a device: "sectors sectorsize model"
diskinfo() {
	drvctl -p "$1" disk-info 2>/dev/null | awk '
		/<key>/ { gsub(/.*<key>|<\/key>.*/, ""); k = $0; next }
		/<integer>/ { gsub(/.*<integer>|<\/integer>.*/, ""); v[k] = $0; next }
		/<string>/ { gsub(/.*<string>|<\/string>.*/, ""); v[k] = $0; next }
		END { if (v["sectors-per-unit"] != "")
			print v["sectors-per-unit"], v["sector-size"], v["type"] }'
}

mnt() { echo "$mounts" | awk -v d="$1" '$1 == d { printf "%s%s", s, $2; s = "," }'; }

# name size type fstype mountpoints label; a tree prefix (├─ or └─) in
# $pre takes two columns of the name's twelve.
row() {
	if [ -n "$pre" ]; then w=10; else w=12; fi
	printf "%s%-${w}s %${sw}s %-5s %-8s %-12s %s\n" "$pre" "$1" "$2" "$3" "$4" "$6" "$5"
}

pre=
row NAME SIZE TYPE FSTYPE LABEL MOUNTPOINTS
for d in $disks; do
	set -- $(diskinfo $d)
	if [ $# -lt 2 ]; then pre=; row "$d" - disk - "(no media)" ""; continue; fi
	secsize=$(($2)); model=$3; pre=
	row "$d" "$(human $(($1 * $2)))" disk "" "$model" "$(mnt $d)"

	wedges=$(dkctl $d listwedges 2>/dev/null | awk -F': ' '/^dk[0-9]/ {print $1}')
	if [ -n "$wedges" ]; then
		n=$(echo "$wedges" | wc -l); i=0
		for w in $wedges; do
			i=$((i + 1)); [ $i -eq $n ] && pre="└─" || pre="├─"
			info=$(dkctl $w getwedgeinfo 2>/dev/null | sed -n 2p)
			blocks=$(echo "$info" | awk '{print $2}')
			fstype=$(echo "$info" | sed 's/.*type: //')
			label=$(dkctl $w getwedgeinfo 2>/dev/null | sed -n '1s/^[^:]*: //p')
			row "$w" "$(human $((blocks * secsize)))" part "$fstype" "$label" "$(mnt $w)"
		done
		continue
	fi

	# No wedges: the disklabel's partitions, without the raw ones (c, d).
	raw=$(sysctl -n kern.rawpartition 2>/dev/null || echo 3)
	disklabel $d 2>/dev/null | awk -v raw=$raw '
		/^ +[a-p]:/ { p = substr($1, 1, 1); if (index("abcdefghijklmnop", p) - 1 == raw) next
			if (p == "c" || $4 == "unused") next; print p, $2, $4 }' |
	{ parts=$(cat); n=$(echo "$parts" | grep -c .); i=0
	  echo "$parts" | while read p size fstype; do
		[ -n "$p" ] || continue
		i=$((i + 1)); [ $i -eq $n ] && pre="└─" || pre="├─"
		row "$d$p" "$(human $((size * secsize)))" part "$fstype" "" "$(mnt $d$p)"
	  done; }
done
