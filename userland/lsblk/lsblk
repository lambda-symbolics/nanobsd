#!/bin/sh
# lsblk [-p|-c] [disk ...] - the disks and what is on them: GPT wedges or
# disklabel partitions with sizes in real units (KiB/MiB/GiB), file system,
# label, mount point with options and usage, swap use, and for NVMe drives
# the model, serial, firmware, sector size, temperature, wear, hours and
# data written.  Colour on a terminal; -p plain, -c forces colour.
# LISPBSD, 2026-10-12 (replaces the 10-06 one, whose units were off).
export PATH=/sbin:/usr/sbin:/bin:/usr/bin

color=0; [ -t 1 ] && [ -z "$NO_COLOR" ] && color=1
case "$1" in -p) color=0; shift;; -c) color=1; shift;; esac
disks="$*"
[ -z "$disks" ] && disks=$(sysctl -n hw.disknames | tr ' ' '\n' | grep -v '^dk' | tr '\n' ' ')

{
	for d in $disks; do
		echo "DISK $d"
		dkctl "$d" getgeometry 2>/dev/null | sed "s|^|GEOM $d |"
		dkctl "$d" listwedges 2>/dev/null | sed "s|^|WEDGE $d |"
		disklabel "$d" 2>/dev/null | sed "s|^|LABEL $d |"
		for p in $(dkctl "$d" listwedges 2>/dev/null | sed -n 's/^\(dk[0-9]*\):.*/\1/p'); do
			echo "FSTYP $d $p $(fstyp -l /dev/r$p 2>/dev/null)"
		done
		case $d in
		ld*)
			n=$(dmesg | sed -n "s/^.*\] $d at \(nvme[0-9]*\) .*/\1/p" | tail -1)
			[ -z "$n" ] && n="nvme${d#ld}"
			nvmectl identify "$n" 2>/dev/null | sed "s|^|ID $d |"
			nvmectl identify "${n}ns1" 2>/dev/null | sed "s|^|NS $d |"
			nvmectl logpage -p 2 "$n" 2>/dev/null | sed "s|^|SMART $d |"
			;;
		*)
			dmesg | grep "\] $d: <" | tail -1 | sed "s|^|DMESG $d |"
			;;
		esac
	done
	mount | sed 's|^|MOUNT |'
	df -kP 2>/dev/null | sed 's|^|DF |'
	swapctl -l 2>/dev/null | sed 's|^|SWAP |'
} | awk -v color="$color" '
function esc(s) { return color ? "\033[" s "m" : "" }
function hum(b,    u, i) {
	split("B KiB MiB GiB TiB PiB", u, " ")
	i = 1
	while (b >= 1024 && i < 6) { b /= 1024; i++ }
	return (i == 1 ? sprintf("%d %s", b, u[i]) : sprintf("%.1f %s", b, u[i]))
}
function pct(p) {
	return (p >= 90 ? esc("1;31") : p >= 70 ? esc("33") : esc("32")) p " %" esc("0")
}
function fsinfo(dev,    s, u, a, mp) {
	if (dev in swapdev)
		return esc("36") "[SWAP]" esc("0") "  " pct(swapcap[dev]) " used"
	if (!(dev in mnt))
		return ""
	mp = mnt[dev]
	s = esc("1;32") mp esc("0")
	if (opts[dev] != "")
		s = s " " esc("2") "(" opts[dev] ")" esc("0")
	if (dev in dfused)
		s = s "  " hum(dfused[dev] * 1024) " used, " hum(dfavail[dev] * 1024) " free, " pct(dfcap[dev])
	return s
}
function printpart(d, name, blocks, type, label, last,    pre, dev) {
	pre = (last ? "└─" : "├─")
	dev = "/dev/" name
	if (dev in fstype) type = fstype[dev]
	else if (name in probed) type = probed[name]
	if (label == "" && name in plabel) label = plabel[name]
	printf("  %s%s%-8s%s %s%12s%s  %s%-5s%s %s%-8s%s %s%s%s  %s\n",
	    esc("2"), pre, esc("0") esc("1;36") name, esc("0"),
	    esc("33"), hum(blocks * bsize[d]), esc("0"),
	    esc("0"), "part", esc("0"),
	    esc("35"), type, esc("0"),
	    esc("2"), label, esc("0"),
	    fsinfo("/dev/" name))
}
$1 == "DISK" { nd++; disk[nd] = $2; next }
$1 == "GEOM" && $5 == "bytes" { bytes[$2] = $4; bsize[$2] = $10; next }
$1 == "WEDGE" && $3 ~ /^dk[0-9]+:$/ {
	d = $2; name = substr($3, 1, length($3) - 1)
	rest = $0; sub(/^WEDGE [^ ]+ [^ ]+ /, "", rest)
	type = ""; if (match(rest, /, type: [^,]*$/)) { type = substr(rest, RSTART + 8); rest = substr(rest, 1, RSTART - 1) }
	blocks = 0; if (match(rest, /, [0-9]+ blocks at [0-9]+$/)) { split(substr(rest, RSTART + 2), b, " "); blocks = b[1]; rest = substr(rest, 1, RSTART - 1) }
	nw[d]++; wname[d, nw[d]] = name; wblocks[d, nw[d]] = blocks; wtype[d, nw[d]] = type
	wlabel[d, nw[d]] = (rest ~ /^[0-9a-f-]{36}$/ ? "" : rest)
	next
}
$1 == "LABEL" && $3 ~ /^[a-p]:$/ && $4 > 0 && $6 != "unused" {
	d = $2; nl[d]++; lname[d, nl[d]] = d substr($3, 1, 1); lblocks[d, nl[d]] = $4; ltype[d, nl[d]] = $6; next
}
$1 == "ID" && $3 == "Model" { s = $0; sub(/^ID [^ ]+ Model Number: */, "", s); gsub(/_/, " ", s); model[$2] = s; next }
$1 == "ID" && $3 == "Serial" { serial[$2] = $NF; next }
$1 == "ID" && $3 == "Firmware" && $4 == "Version:" { fw[$2] = $NF; next }
$1 == "NS" && $3 == "Current" && $4 == "LBA" { curfmt[$2] = $NF; next }
$1 == "NS" && $3 == "LBA" && $4 == "Format" && ($5 == curfmt[$2] ":" || substr($5, 1, length($5) - 1) == curfmt[$2]) { lba[$2] = $8; next }
$1 == "SMART" && $3 == "Temperature:" && $5 == "K," { temp[$2] = sprintf("%.0f", $6); next }
$1 == "SMART" && $3 == "Percentage" && $4 == "used:" { wear[$2] = $5; next }
$1 == "SMART" && $3 == "Power" && $4 == "on" { hours[$2] = $6; next }
$1 == "SMART" && $3 == "Data" && $4 == "units" && $5 == "written:" { s = $0; sub(/.*\(/, "", s); sub(/\).*/, "", s); written[$2] = s; next }
$1 == "SMART" && $3 == "Unsafe" { unsafe[$2] = $5; next }
$1 == "SMART" && $3 == "Media" { merr[$2] = $5; next }
$1 == "FSTYP" && NF >= 4 { probed[$3] = $4; s = $0; sub(/^FSTYP [^ ]+ [^ ]+ [^ ]+ ?/, "", s); plabel[$3] = s; next }
$1 == "DMESG" { s = $0; sub(/^DMESG [^ ]+ .*: </, "", s); sub(/>.*/, "", s); gsub(/ +/, " ", s); model[$2] = s; next }
$1 == "MOUNT" && $2 ~ /^\/dev\// {
	mnt[$2] = $4; fstype[$2] = $6
	s = $0; sub(/.*\(/, "", s); sub(/\).*/, "", s); gsub(/ /, "", s); sub(/,?local/, "", s); sub(/^,/, "", s); opts[$2] = s; next
}
$1 == "DF" && $2 ~ /^\/dev\// { dfused[$2] = $4; dfavail[$2] = $5; dfcap[$2] = $6 + 0; next }
$1 == "SWAP" && $2 ~ /^\/dev\// { swapdev[$2] = 1; swapcap[$2] = $6 + 0; next }
END {
	printf("%s%-10s %12s  %-5s %-8s %s%s\n", esc("1"), "NAME", "SIZE", "TYPE", "FS", "LABEL / MOUNT", esc("0"))
	for (i = 1; i <= nd; i++) {
		d = disk[i]
		kind = (d ~ /^ld/ ? "nvme" : d ~ /^sd/ ? "usb" : d ~ /^cd/ ? "cd" : "disk")
		printf("%s%-10s%s %s%12s%s  %-5s %-8s %s%s%s\n", esc("1;37"), d, esc("0"),
		    esc("1;33"), hum(bytes[d]), esc("0"), kind, "", esc("1"), model[d], esc("0"))
		if (d in serial) {
			info = "serial " serial[d] "  fw " fw[d]
			if (d in lba) info = info "  " lba[d] " B sectors"
			if (d in temp) info = info "  " (temp[d] >= 60 ? esc("1;31") : temp[d] >= 50 ? esc("33") : "") temp[d] " C" esc("0") esc("2")
			if (d in wear) info = info "  wear " wear[d] " %"
			if (d in hours) info = info "  " hours[d] " h on"
			if (d in written) info = info "  " written[d] " written"
			if (unsafe[d] > 0) info = info "  " unsafe[d] " unsafe shutdowns"
			if (merr[d] > 0) info = info "  " esc("1;31") merr[d] " media errors" esc("0") esc("2")
			printf("  %s│ %s%s\n", esc("2"), info, esc("0"))
		}
		if (nw[d] > 0)
			for (j = 1; j <= nw[d]; j++)
				printpart(d, wname[d, j], wblocks[d, j], wtype[d, j], wlabel[d, j], j == nw[d])
		else if (nl[d] > 0)
			for (j = 1; j <= nl[d]; j++)
				printpart(d, lname[d, j], lblocks[d, j], ltype[d, j], "", j == nl[d])
		else
			printf("  %s└─(no partitions)%s\n", esc("2"), esc("0"))
	}
}'
