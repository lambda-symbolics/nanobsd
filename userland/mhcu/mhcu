#!/bin/sh
# mhcu: drive the Mahogany desktop (computer use) through its control socket.
# Every command prints one JSON value.  Coordinates are layout pixels (the
# panel is 2160x1350); screenshots can be scaled, coordinates never are.
# See docs/computer-use.org.  Runs as root or as the session user.

: ${MAHOGANY_SOCKET:=/var/run/user/1000/mahogany.sock}
export MAHOGANY_SOCKET
CTL=/usr/local/bin/mahoganyctl

usage() {
	cat >&2 <<'EOF'
usage: mhcu screen | windows | focused
       mhcu focus ID | close ID | group N
       mhcu move X Y | click X Y [BUTTON [COUNT]] | dclick X Y   [--mods M]
       mhcu down [BUTTON] | up [BUTTON]
       mhcu drag X1 Y1 X2 Y2 [X3 Y3 ...] [BUTTON [STEPS]]  [--mods M]
            [--steps N] [--step-ms MS] [--pause MS] [--hold MS] [--nowait]
       mhcu scroll X Y DY [DX] [--pixels] [--mods M]
                                         (DY > 0 down; wheel clicks or pixels)
       mhcu busy | abort                 (a drag still playing; stop it)
       mhcu key CHORD...                 (ctrl+l  super+Return  F5  alt+Tab)
       mhcu hold KEY down|up             (shift, ctrl, a key name)
       mhcu type TEXT                    (newlines become Return)
       mhcu shot [FILE] [SCALE] [X Y W H]  (PNG; prints path, scale, size)
       mhcu wake                         (undim/unblank the panel, wait for it)
       mhcu launch COMMAND-LINE
       mhcu find APP_ID                  (the mapped windows with APP_ID)
       mhcu wait APP_ID [SECONDS]        (until a window with APP_ID maps)
       mhcu clip | setclip TEXT          (the clipboard)
       mhcu mirror [status | start [TARGET [SOURCE]] | stop [TARGET] | toggle |
                    fit contain|cover|stretch|exact | region [X Y W H] |
                    freeze | thaw | shot [FILE] | rescan]
       mhcu sleep MS
       mhcu eval FORM
BUTTON: left right middle side extra    M: ctrl, shift+alt, super...
EOF
	exit 2
}

# Send FORM; print the JSON the command returned (a Lisp string, unquoted).
call() {
	out=$($CTL "$1") || { echo "{\"error\":\"mahoganyctl failed\"}"; return 1; }
	case $out in
	\"*\") printf '%s\n' "$out" | sed 's/^"//; s/"$//; s/\\\(.\)/\1/g' ;;
	ERROR:*) printf '{"error":"%s"}\n' "$(printf '%s' "$out" | sed 's/["\\]/\\&/g')"; return 1 ;;
	*) printf '%s\n' "$out" ;;
	esac
}

# Wait until a timed sequence (click, drag) has played; print its answer.
played() {
	case $1 in *'"error"'*) echo "$1"; return 1 ;; esac
	if [ -z "$nowait" ]; then
		i=0
		while [ $i -lt 600 ]; do
			case $(call "(cu-busy)") in *false*) break ;; esac
			sleep 0.02; i=$((i + 1))
		done
	fi
	echo "$1"
}

hex() { printf '%s' "$1" | od -An -tx1 | tr -d ' \n'; }
num() { case $1 in ''|*[!0-9.-]*) echo "mhcu: not a number: $1" >&2; exit 2 ;; esac; }
lispstr() { printf '"%s"' "$(printf '%s' "$1" | sed 's/["\\]/\\&/g')"; }

[ $# -ge 1 ] || usage
cmd=$1; shift

# Options of the pointer commands; the rest stays positional.
mods= pixels= steps= stepms= pause= hold= nowait=
case $cmd in
click|dclick|drag|scroll)
	pos=
	while [ $# -gt 0 ]; do
		case $1 in
		--mods)    mods=$2; shift ;;
		--pixels)  pixels=1 ;;
		--steps)   steps=$2; shift ;;
		--step-ms) stepms=$2; shift ;;
		--pause)   pause=$2; shift ;;
		--hold)    hold=$2; shift ;;
		--nowait)  nowait=1 ;;
		--*)       usage ;;
		*)         pos="$pos $1" ;;
		esac
		shift
	done
	set -- $pos ;;
esac
modarg=
[ -n "$mods" ] && modarg=" :mods $(lispstr "$mods")"

case $cmd in
screen)  call "(cu-screen)" ;;
windows) call "(cu-windows)" ;;
focused) call "(cu-focused)" ;;
focus)   num "$1"; call "(cu-focus $1)" ;;
close)   num "$1"; call "(cu-close $1)" ;;
group)   num "$1"; call "(cu-select-group $1)" ;;
move)    num "$1"; num "$2"; call "(cu-move $1 $2)" ;;
click)   num "$1"; num "$2"
	 played "$(call "(cu-click $1 $2 :button :${3:-left} :count ${4:-1}$modarg)")" ;;
dclick)  num "$1"; num "$2"; played "$(call "(cu-click $1 $2 :count 2$modarg)")" ;;
down)    call "(cu-button :${1:-left} :down)" ;;
up)      call "(cu-button :${1:-left} :up)" ;;
drag)    pts= button=left
	 while [ $# -gt 0 ]; do
		case $1 in
		[0-9-]*) num "$1"; pts="$pts $1" ;;
		*) button=$1; [ -n "$2" ] && { num "$2"; steps=$2; shift; } ;;
		esac
		shift
	 done
	 opts=" :button :$button$modarg"
	 [ -n "$steps" ] && opts="$opts :steps $steps"
	 [ -n "$stepms" ] && opts="$opts :step-ms $stepms"
	 [ -n "$pause" ] && opts="$opts :pause-ms $pause"
	 [ -n "$hold" ] && opts="$opts :hold-ms $hold"
	 played "$(call "(cu-drag '($pts)$opts)")" ;;
scroll)  num "$1"; num "$2"; num "$3"
	 px=; [ -n "$pixels" ] && px=" :pixels t"
	 call "(cu-scroll $1 $2 :dy $3 :dx ${4:-0}$px$modarg)" ;;
wake)    call "(cu-wake)" >/dev/null; i=0
	 while [ $i -lt 50 ]; do
		case $(call "(cu-screen)") in *'"panel":"on"'*) break ;; esac
		sleep 0.1; i=$((i + 1))
	 done
	 sleep 0.2	# the panel's first frames after power-on
	 call "(cu-screen)" | sed 's/.*\("panel":"[a-z]*"\).*/{\1}/' ;;
busy)    call "(cu-busy)" ;;
abort)   call "(cu-abort)" ;;
key)     [ $# -ge 1 ] || usage
	 forms=""; for c in "$@"; do forms="$forms $(lispstr "$c")"; done
	 call "(cu-key$forms)" ;;
hold)    [ $# -eq 2 ] || usage; call "(cu-key-hold $(lispstr "$1") :$2)" ;;
type)    [ $# -ge 1 ] || usage; call "(cu-type-hex \"$(hex "$*")\")" ;;
launch)  [ $# -ge 1 ] || usage; call "(cu-launch-hex \"$(hex "$*")\")" ;;
shot)
	file=${1:-/tmp/mhcu-$$.png}; scale=${2:-1}
	case $file in /*) ;; *) file=$PWD/$file ;; esac
	rm -f "$file"
	if [ $# -ge 6 ]; then
		for a in "$3" "$4" "$5" "$6"; do num "$a"; done
		r=$(call "(cu-screenshot $(lispstr "$file") :scale $scale :x $3 :y $4 :width $5 :height $6)") || { echo "$r"; exit 1; }
	else
		r=$(call "(cu-screenshot $(lispstr "$file") :scale $scale)") || { echo "$r"; exit 1; }
	fi
	i=0
	while [ ! -s "$file" ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
	if [ ! -s "$file" ]; then
		echo "{\"error\":\"screenshot did not appear\",\"path\":\"$file\"}"; exit 1
	fi
	size=$(file -b "$file" | sed -n 's/.* \([0-9]*\) x \([0-9]*\).*/\1 \2/p')
	set -- $size
	printf '{"path":"%s","scale":%s,"width":%s,"height":%s}\n' \
	    "$file" "$scale" "${1:-0}" "${2:-0}" ;;
wait)
	[ $# -ge 1 ] || usage; t=$(( ${2:-10} * 10 )); i=0
	while [ $i -lt $t ]; do
		w=$(call "(cu-find-app $(lispstr "$1"))")
		case $w in \[\]|\{\"error*) ;; *) printf '%s\n' "$w"; exit 0 ;; esac
		sleep 0.1; i=$((i + 1))
	done
	echo "{\"error\":\"no window with app_id $1\"}"; exit 1 ;;
find)    [ $# -eq 1 ] || usage; call "(cu-find-app $(lispstr "$1"))" ;;
clip)    XDG_RUNTIME_DIR=${MAHOGANY_SOCKET%/*} WAYLAND_DISPLAY=wayland-0 \
	     /usr/pkg/bin/wl-paste -n 2>/dev/null |
	 awk 'BEGIN { ORS = ""; print "{\"clipboard\":\"" }
	      { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t")
	        if (NR > 1) print "\\n"; print }
	      END { print "\"}\n" }' ;;
setclip) [ $# -ge 1 ] || usage
	 printf '%s' "$*" | XDG_RUNTIME_DIR=${MAHOGANY_SOCKET%/*} \
	     WAYLAND_DISPLAY=wayland-0 /usr/pkg/bin/wl-copy &&
	     echo '{"clipboard":"set"}' ;;
mirror)  act=${1:-status}; [ $# -gt 0 ] && shift
	 case $act in
	 shot)	file=${1:-/tmp/mhcu-mirror-$$.png}
		case $file in /*) ;; *) file=$PWD/$file ;; esac
		rm -f "$file"
		r=$(call "(mirror-command \"shot\" $(lispstr "$file"))")
		case $r in *'"error"'*) echo "$r"; exit 1 ;; esac
		i=0; while [ ! -s "$file" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
		[ -s "$file" ] && printf '{"path":"%s"}\n' "$file" ||
		    { echo "{\"error\":\"no frame from the mirror target\"}"; exit 1; } ;;
	 region) [ $# -eq 0 ] || [ $# -eq 4 ] || usage
		for a in "$@"; do num "$a"; done
		call "(mirror-command \"region\"$(for a in "$@"; do printf ' %s' "$a"; done))" ;;
	 *)	forms=""; for a in "$@"; do forms="$forms $(lispstr "$a")"; done
		call "(mirror-command $(lispstr "$act")$forms)" ;;
	 esac ;;
sleep)   num "$1"; sleep "$(echo "scale=3; $1 / 1000" | bc)"; echo '{"slept":'"$1"'}' ;;
eval)    [ $# -eq 1 ] || usage; $CTL "$1" ;;
*)       usage ;;
esac
