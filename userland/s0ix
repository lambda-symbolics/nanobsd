#!/bin/sh
# Kernel-coordinated s2idle. Requires the freeze busy-status interface.
PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/pkg/sbin:/usr/pkg/bin
export PATH
BR=/var/run/s0ix.brightness
LOCK=/var/run/s0ix.lock
restore_brightness()
{
	b=$(cat "$BR" 2>/dev/null)
	case "$b" in ''|*[!0-9]*) return ;; esac
	sysctl -w hw.acpi.acpiout15.brightness="$b" >/dev/null 2>&1
	sysctl -w hw.acpi.acpiout16.brightness="$b" >/dev/null 2>&1
}
case "$1" in
suspend)
	mkdir "$LOCK" 2>/dev/null || exit 0
	trap 'rmdir "$LOCK"' EXIT
	sysctl -n hw.acpi.acpiout15.brightness > "$BR" || exit 1
	sysctl -w hw.acpi.acpiout15.brightness=0 >/dev/null 2>&1
	sysctl -w hw.acpi.acpiout16.brightness=0 >/dev/null 2>&1
	if ! sysctl -w hw.acpi.sleep.freeze=1 >/dev/null; then
		restore_brightness
		exit 1
	fi
	while [ "$(sysctl -n hw.acpi.sleep.freeze)" = 1 ]; do sleep 1; done
	restore_brightness
	logger -t s0ix "resumed"
	;;
resume)
	restore_brightness
	;;
*) echo "usage: s0ix suspend|resume" >&2; exit 1 ;;
esac
