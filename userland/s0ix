#!/bin/sh
# Kernel-coordinated s2idle. Requires the freeze busy-status interface.
PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/pkg/sbin:/usr/pkg/bin
export PATH
LOCK=/var/run/s0ix.lock
TICKLESS=
restore_tickless()
{
	case "$TICKLESS" in
	0|1) sysctl -w machdep.cidle.tickless="$TICKLESS" >/dev/null ;;
	esac
}
charge() { envstat -d acpibat0 2>/dev/null | awk '/charge:/ {print $2; exit}'; }
onac() { envstat -d acpiacad0 2>/dev/null | awk '/connected/ {print $2}'; }
# The firmware's display-off _DSM drops the backlight to its minimum and the
# display-on one does not bring it back, so put the level back after a wake.
# Through brightness(1), never a raw replay: it owns the level, knows the
# level for the supply in use now (the charger may have been plugged or
# pulled while asleep) and leaves a dimmed panel dimmed.  This used to save
# the raw hardware level before the freeze and write it back, bypassing all
# of that.
restore_brightness()
{
	[ -x /usr/local/bin/brightness ] &&
	    /usr/local/bin/brightness restore >/dev/null 2>&1
}
case "$1" in
suspend)
	mkdir "$LOCK" 2>/dev/null || exit 0
	trap 'restore_tickless; rmdir "$LOCK"' EXIT
	TICKLESS=$(sysctl -n machdep.cidle.tickless) || exit 1
	# The low-power hold needs tickless idle; restore the awake policy on exit.
	sysctl -w machdep.cidle.tickless=1 >/dev/null || exit 1
	# Do not touch the level here: i915 turns the panel off for the freeze
	# anyway.  (Zeroing it once made every resume flash at full brightness.)
	# Whole-machine power over the suspension, from the battery gauge.
	c0=$(charge); a0=$(onac); t0=$(date +%s)
	if ! sysctl -w hw.acpi.sleep.freeze=1 >/dev/null; then
		restore_brightness
		exit 1
	fi
	while [ "$(sysctl -n hw.acpi.sleep.freeze)" = 1 ]; do sleep 1; done
	restore_brightness
	c1=$(charge); t1=$(date +%s)
	if [ "$a0" = FALSE ] && [ "$(onac)" = FALSE ] && [ -n "$c0" ] && [ -n "$c1" ] && [ $((t1 - t0)) -ge 120 ]; then
		logger -t s0ix "resumed after $((t1 - t0)) s on battery: $c0 -> $c1 Wh, $(echo "scale=2; ($c0 - $c1) * 3600 / ($t1 - $t0)" | bc) W"
	else
		logger -t s0ix "resumed after $((t1 - t0)) s"
	fi
	;;
resume)
	restore_brightness
	;;
*) echo "usage: s0ix suspend|resume" >&2; exit 1 ;;
esac
