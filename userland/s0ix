#!/bin/sh
# s2idle deep suspend for the X1 Nano. The KERNEL coordinator owns the whole
# transition: hw.acpi.sleep.freeze=1 triggers acpi_enter_freeze(), which detaches
# X, freezes userspace, pmf-suspends xHCI/i915/iwx (preserving GPU RC6 via the
# i915s0idle latch so the package can reach deep C-states), sends the LPS0 _DSM
# ENTRY (EC slow-blink LED), and holds until lid-open wakes it IN-KERNEL
# (acpilid_status_changed -> acpi_freeze_wakeup). This script only manages the
# panel backlight, which is outside the coordinator.
export PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/pkg/sbin:/usr/pkg/bin
BR=/var/run/s0ix.brightness
case "$1" in
suspend)
	sysctl -n hw.acpi.acpiout15.brightness > $BR 2>/dev/null
	sysctl -w hw.acpi.acpiout15.brightness=0 >/dev/null 2>&1
	sysctl -w hw.acpi.acpiout16.brightness=0 >/dev/null 2>&1
	sysctl -w hw.acpi.sleep.freeze=1 >/dev/null 2>&1
	logger -t s0ix "suspend: requested kernel s2idle freeze"
	;;
resume)
	b=$(cat $BR 2>/dev/null)
	[ -n "$b" ] && {
		sysctl -w hw.acpi.acpiout15.brightness="$b" >/dev/null 2>&1
		sysctl -w hw.acpi.acpiout16.brightness="$b" >/dev/null 2>&1
	}
	logger -t s0ix "resume: restored brightness $b"
	;;
*) echo "usage: s0ix suspend|resume" >&2; exit 1 ;;
esac
