#!/bin/sh
# screenshot - freeze the screen, select a region, save it timestamped and put
# it on the clipboard.
#
# The freeze matters: scrot -f grabs the screen FIRST and lets you crop the
# frozen image, so nothing moves or disappears while you are selecting.  This
# is the hacksaw+shotgun behaviour; scrot(1) 2.x does both natively here, so
# no extra Rust tooling is needed.
#
# usage: screenshot [area|full|window]      (default: area)

PATH=/usr/pkg/bin:/usr/X11R7/bin:/usr/local/bin:/bin:/usr/bin; export PATH
DIR=${SCREENSHOT_DIR:-$HOME}
OUT="$DIR/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"

# One screenshot at a time: PrtSc pressed while the selection overlay is up
# does nothing (it would capture the overlay and stack a second one on it).
# The lock is fd 9, held until this script exits; the clipboard owners below
# outlive it, so they are started with fd 9 closed.  sh(1) opens exec'd fds
# close-on-exec, which would hide it from flock(1): fdflags clears that.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/screenshot.lock"
fdflags -s -cloexec 9
flock -n 9 || exit 0

# Dashed accent-coloured selection box, matching the status bar's palette.
SELOPTS='--line style=dash,width=2,color=#E46876'

if [ -n "$WAYLAND_DISPLAY" ]; then
	# Under Mahogany: freezeshot captures first and shows the frozen frame
	# while you drag (the scrot -f behaviour), in the accent colour; grim
	# takes whole screens.
	case "${1:-area}" in
	area)	freezeshot "$OUT" >/dev/null || exit 1 ;;
	window|full)
		grim "$OUT" || exit 1 ;;
	*)	echo "usage: screenshot [area|full|window]" >&2; exit 2 ;;
	esac
	[ -s "$OUT" ] || { echo "screenshot: capture produced nothing" >&2; exit 1; }
	command -v wl-copy >/dev/null 2>&1 && wl-copy < "$OUT" 9>&-
	echo "$OUT"
	exit 0
fi

case "${1:-area}" in
area)	# freeze, then crop; scrot exits non-zero if the selection is cancelled
	scrot -f -s $SELOPTS "$OUT" || exit 1 ;;
window)	scrot -u "$OUT" || exit 1 ;;
full)	scrot "$OUT" || exit 1 ;;
*)	echo "usage: screenshot [area|full|window]" >&2; exit 2 ;;
esac

[ -s "$OUT" ] || { echo "screenshot: capture produced nothing" >&2; exit 1; }

# Clipboard: xclip must keep running to own the selection, so detach it.
if command -v xclip >/dev/null 2>&1; then
	nohup xclip -selection clipboard -t image/png -i "$OUT" \
	    >/dev/null 2>&1 9>&- &
fi
echo "$OUT"
