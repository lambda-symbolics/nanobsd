#!/bin/sh
# One-shot NetBSD status snapshot. Collect each subsystem once, parse in one awk.
PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/pkg/bin:/usr/local/bin
export PATH

{
  echo '@ram'; vmstat -s 2>/dev/null
  echo '@cpu'; sysctl -n kern.cp_time 2>/dev/null
  echo '@sensors'; envstat 2>/dev/null
  echo '@audio'; mixerctl -a 2>/dev/null
  echo '@wifi'; ifconfig iwx0 2>/dev/null
  echo '@clock'; date +%H:%M
} | awk -v state="${STATUSBAR_CPU_STATE:-/tmp/.statusbar.cp}" '
  BEGIN {
    ram=cpu=temp=vol=mic=bat=bats="?"
    volm=micm="off"; ssid=""; clk="--:--"
  }
  /^@(ram|cpu|sensors|audio|wifi|clock)$/ { section=$0; next }
  section=="@ram" {
    if ($0 ~ /^ *[0-9]+ pages managed$/) managed=$1
    if ($0 ~ /^ *[0-9]+ pages free$/) free=$1
    if ($0 ~ /^ *[0-9]+ cached (file|executable) pages$/) cache+=$1
  }
  section=="@cpu" {
    for (i=1; i<=NF; i++) if ($i ~ /^[0-9]+,?$/) {
      value=$i; gsub(/,/, "", value); ticks[++nticks]=value
    }
  }
  section=="@sensors" {
    if ($0 ~ /^\[/) device=$0
    if (device ~ /^\[coretemp/ && /temperature:/)
      for (i=1; i<=NF; i++) if ($i ~ /^[0-9]+\.[0-9]+$/ && $i+0>hottest)
        hottest=$i+0
    if (device=="[acpibat0]") {
      if (/charge:/ && !/rate|design|warning|low|critical/)
        for (i=1; i<=NF; i++) if ($i ~ /^\(?[0-9.]+%\)?$/) {
          value=$i; gsub(/[()%]/, "", value); bat=int(value)
        }
      if (/charging:/) bats=($2=="TRUE" || $2=="ON")?"chg":"dis"
      if (/(present|connected):/ && $2=="FALSE") absent=1
    }
    if (device=="[acpiacad0]" && /connected:/) ac=$2
  }
  section=="@audio" {
    split($0, pair, "="); audio[pair[1]]=pair[2]
  }
  section=="@wifi" && /ssid/ {
    for (i=1; i<=NF; i++) if ($i=="ssid") { ssid=$(i+1); break }
  }
  section=="@clock" { clk=$0 }
  END {
    if (managed>0) ram=int((managed-free-cache)*100/managed)
    if (nticks==5) {
      if ((getline previous < state)>0 && split(previous, old, " ")==5) {
        for (i=1; i<=5; i++) delta+=ticks[i]-old[i]
        idle=ticks[5]-old[5]
        if (delta>0 && idle>=0 && idle<=delta) cpu=int((delta-idle)*100/delta)
        else if (delta==0) cpu=0
      }
      close(state)
      printf "%s %s %s %s %s\n", ticks[1],ticks[2],ticks[3],ticks[4],ticks[5] > state
      close(state)
    }
    if (hottest>0) temp=int(hottest)
    if ("outputs.master" in audio) {
      split(audio["outputs.master"], channels, ","); vol=int((channels[1]*100+127)/255)
    }
    if ("record.mic" in audio) {
      split(audio["record.mic"], channels, ","); mic=int((channels[1]*100+127)/255)
    }
    if ("outputs.master.mute" in audio) volm=audio["outputs.master.mute"]
    else if ("outputs.master3.mute" in audio) volm=audio["outputs.master3.mute"]
    if ("record.mic2.mute" in audio) micm=audio["record.mic2.mute"]
    else if ("record.mic.mute" in audio) micm=audio["record.mic.mute"]
    if (ac=="TRUE" && bats=="dis") bats="plug"
    if (ac=="TRUE" && bat==100) bats="full"
    if (absent) bats="none"
    printf "ram=%s cpu=%s temp=%s vol=%s volm=%s mic=%s micm=%s bat=%s bats=%s ssid=%s clk=%s\n", ram,cpu,temp,vol,volm,mic,micm,bat,bats,ssid,clk
  }
'
