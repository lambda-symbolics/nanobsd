#!/bin/sh
# usb on|off|status [all|pch|usbc] - power policy for the two xHCI controllers.
#   pch  : xhci1, the PCH controller with the internal devices (Bluetooth,
#          camera, fingerprint).  off = driver suspended (D3hot).
#   usbc : xhci0, the USB-C/Thunderbolt controller (external ports only).
#          off = TCSS D3cold: xhci0 is suspended (ports quiesced, D3hot: a
#          merely halted controller caps the package at PC9), detached, and
#          the shared TCSS power resource (D3C, also held by the Thunderbolt
#          DMA engines and root ports) is switched off through idle_d3; the
#          package then idles in PC10 (about 1.1 W) instead of a PC3/PC10
#          split (about 1.9 W).  on = resource back, pci0 rescan reattaches
#          xhci0 fresh (a cold controller cannot be warm-resumed).
#   all  : both (default).  rc.local does "usb off" at boot.
# Keyboard/trackpoint are I2C-HID, USB-C charging (PD) is separate: both keep
# working with everything off.  bluetooth/webcam/bt-headphones use "pch" so
# the unused USB-C block stays cold.  USB_TCSS_D3=0 keeps usbc at D3hot only.
PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/pkg/sbin:/usr/pkg/bin; export PATH
SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="doas"
attached(){ drvctl -l pci0 2>/dev/null | grep -q "^pci0 $1\$"; }
# drvctl -R resumes a device and its ancestors, not its children, so a
# resumed controller leaves every USB device under it marked suspended in
# pmf (harmless for drivers without handlers, but the runtime PM only parks
# an *active* ubt).  Resume the whole subtree, leaves last.
resume_tree(){
  $SUDO drvctl -R "$1" 2>/dev/null
  for c in $(drvctl -l "$1" 2>/dev/null | awk '{print $2}'); do resume_tree "$c"; done
}
# The PCI bus driver puts a suspended function in D3hot (PMCSR), so the
# config-space power state tells a suspended controller from a running one.
active(){ case $1 in xhci0) d=13 ;; xhci1) d=20 ;; esac
  pcictl pci0 dump -d $d -f 0 2>/dev/null | grep -q 'Power state: D0'; }
cold(){ [ "$(sysctl -n hw.acpi.sleep.idle_d3 2>/dev/null)" = 1 ]; }
dom=${2:-all}
case "$dom" in all|pch|usbc) ;; *) echo "usage: usb [on|off|status] [all|pch|usbc]" >&2; exit 1 ;; esac
pch_off(){
  attached xhci1 || return 0
  active xhci1 || return 0
  $SUDO drvctl -S xhci1 2>/dev/null || { echo "usb: xhci1 did not suspend" >&2; return 1; }
}
pch_on(){
  attached xhci1 || { echo "usb: no xhci1" >&2; return 1; }
  if ! active xhci1; then
    $SUDO drvctl -R xhci1 2>/dev/null || { echo "usb: xhci1 did not resume" >&2; return 1; }
  fi
  resume_tree xhci1
}
usbc_off(){
  if attached xhci0 && active xhci0; then
    $SUDO drvctl -S xhci0 2>/dev/null || { echo "usb: xhci0 did not suspend" >&2; return 1; }
  fi
  [ "${USB_TCSS_D3:-1}" = 1 ] || return 0
  # USB_TCSS_DETACH=0: leave the suspended driver attached (the kernel then
  # needs idle_d3_exp bit 4 to cold the controller, and a power-loss-aware
  # xhci_resume to bring it back: experiment).
  if attached xhci0 && [ "${USB_TCSS_DETACH:-1}" = 1 ]; then
    $SUDO drvctl -d xhci0 2>/dev/null || { echo "usb: xhci0 did not detach" >&2; return 1; }
  fi
  cold && return 0
  $SUDO sysctl -w hw.acpi.sleep.idle_d3=1 >/dev/null 2>&1 || { echo "usb: TCSS power resources not switched off (idle_d3)" >&2; return 1; }
  cold || { echo "usb: idle_d3 did not take" >&2; return 1; }
}
usbc_on(){
  if cold; then
    $SUDO sysctl -w hw.acpi.sleep.idle_d3=0 >/dev/null 2>&1 || { echo "usb: could not restore the TCSS power resources (idle_d3); not touching xhci0" >&2; return 1; }
  fi
  if ! attached xhci0; then
    $SUDO drvctl -r pci0 2>/dev/null
    attached xhci0 || { echo "usb: xhci0 did not reattach" >&2; return 1; }
    return 0
  fi
  if ! active xhci0; then
    $SUDO drvctl -R xhci0 2>/dev/null || { echo "usb: xhci0 did not resume" >&2; return 1; }
  fi
  resume_tree xhci0
}
state(){
  p=off; attached xhci1 && active xhci1 && p=on
  u=off; if attached xhci0 && active xhci0; then u=on; elif cold; then u=cold; fi
  echo "usb: pch $p, usbc $u"
}
case "${1:-status}" in
  off) rc=0
       case $dom in all) usbc_off || rc=1; pch_off || rc=1 ;; pch) pch_off || rc=$? ;; usbc) usbc_off || rc=$? ;; esac
       [ $rc -eq 0 ] && echo "usb: OFF ($dom): $(state | sed 's/^usb: //')" || echo "usb: partly OFF: $(state | sed 's/^usb: //')"
       exit $rc ;;
  on)  rc=0
       case $dom in all) usbc_on || rc=1; pch_on || rc=1 ;; pch) pch_on || rc=$? ;; usbc) usbc_on || rc=$? ;; esac
       [ $rc -eq 0 ] && echo "usb: ON ($dom): $(state | sed 's/^usb: //')" || echo "usb: partly ON: $(state | sed 's/^usb: //')"
       exit $rc ;;
  status) state ;;
  *) echo "usage: usb [on|off|status] [all|pch|usbc]" >&2; exit 1 ;;
esac
