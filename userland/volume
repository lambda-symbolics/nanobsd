#!/bin/sh
# volume [up|down|mute|get] - adjust every output path at once.
#
# The codec exposes one volume control per output path (outputs.master,
# outputs.master2, ...) and one mute per pin (outputs.master3.mute, ...).
# Which ones are live changes when the headphone jack is used, so a script
# pinned to "outputs.master" silently stops working the moment headphones
# are plugged in.  Enumerate whatever exists instead of hardcoding names.

PATH=/sbin:/usr/sbin:/bin:/usr/bin; export PATH
STEP=${VOL_STEP:-16}

vols() { mixerctl -a | sed -n 's/^\(outputs\.master[0-9]*\)=.*/\1/p'; }
mutes() { mixerctl -a | sed -n 's/^\(outputs\.master[0-9]*\.mute\)=.*/\1/p'; }

case "${1:-get}" in
up)
	for c in $(vols); do mixerctl -w "$c+=$STEP" >/dev/null 2>&1; done ;;
down)
	for c in $(vols); do mixerctl -w "$c-=$STEP" >/dev/null 2>&1; done ;;
mute)
	# If anything is unmuted, mute everything; otherwise unmute everything.
	want=on
	for c in $(mutes); do
		[ "$(mixerctl -n "$c" 2>/dev/null)" = off ] && { want=on; break; }
		want=off
	done
	for c in $(mutes); do mixerctl -w "$c=$want" >/dev/null 2>&1; done ;;
get)
	for c in $(vols); do printf '%s=%s ' "$c" "$(mixerctl -n "$c")"; done; echo ;;
*)
	echo "usage: volume [up|down|mute|get]" >&2; exit 2 ;;
esac
